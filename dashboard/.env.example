# Optional. `npm run dev` defaults to http://localhost:8000 automatically, so this file
# isn't needed for local development against a live API -- copy it to `.env.local` only if
# you want to point at a different API host.
#
# For a production build (`npm run build`), leaving this UNSET is what makes the dashboard
# backend-free: it falls back to reading the static JSON snapshots in public/data/ (see
# scripts/export_static_data.py) instead of calling a live server. Set it explicitly at
# build time to deploy against a real FastAPI backend instead (e.g. one running on Render).
VITE_API_BASE=http://localhost:8000
